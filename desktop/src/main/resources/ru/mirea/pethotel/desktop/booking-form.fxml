<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.mirea.pethotel.desktop.controller.BookingFormController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox>
        <ComboBox fx:id="petComboBox" promptText="питомец"/>
        <ComboBox fx:id="enclosureComboBox" promptText="вольер"/>
        <DatePicker fx:id="startDatePicker" promptText="Дата начала"/>
        <DatePicker fx:id="endDatePicker" promptText="Дата окончания"/>
    </HBox>
    <HBox>
        <!--        <Button text="Сохранить" onAction="#onSaveClick"/>-->
        <Button text="Отменить" onAction="#close"/>
    </HBox>

</VBox>
